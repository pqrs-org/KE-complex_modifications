{
  "title": "TIC-80 Readline-like keybindings",
  "maintainers": [
    "Athesto"
  ],
  "rules": [
    {
      "description": "Readline-like keybindings for the TIC-80 console and editor",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "j",
            "modifiers": {
              "mandatory": [
                "control"
              ]
            }
          },
          "to": [
            {
              "key_code": "return_or_enter"
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.nesbox\\.tic$"
              ],
              "file_paths": [
                "^/Applications/tic80\\.app/Contents/MacOS/tic80$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "b",
            "modifiers": {
              "mandatory": [
                "control",
                "option"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_arrow",
              "modifiers": [
                "option",
                "shift"
              ]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.nesbox\\.tic$"
              ],
              "file_paths": [
                "^/Applications/tic80\\.app/Contents/MacOS/tic80$"
              ]
            }
          ]
        },
        {
          "type": "basic",
