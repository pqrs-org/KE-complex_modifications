{
    "title": "Personal rules (@xu-bu)",
    "maintainers": [
        "xu-bu"
    ],
    "rules": [
        {
            "description": "Command-Alt-T opens a new Terminal window",
            "manipulators": [
                {
                    "from": {
                        "key_code": "t",
                        "modifiers": {
                            "mandatory": [
                                "control",
                                "left_option"
                            ]
                        }
                    },
                    "to": [
                        {
                            "shell_command": "/usr/bin/open -na Terminal"
                        }
                    ],
                    "type": "basic"
                }
            ]
        },
        {
            "description": "Tap left Shift to switch input language",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "left_shift",
                        "modifiers": {
                            "optional": [
                                "any"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "left_shift",
                            "lazy": true
                        }
                    ],
                    "to_if_alone": [
                        {
                            "key_code": "spacebar",
                            "modifiers": [
                                "left_control"
                            ],
                            "hold_down_milliseconds": 100
                        }
                    ]
                }
            ]
        },
        {
            "description": "Alt+Space opens Spotlight",
            "manipulators": [
                {
                    "type": "basic",
                    "conditions": [
                        {
                            "bundle_identifiers": [
                                "^com\\.microsoft\\.rdc$",
                                "^com\\.microsoft\\.rdc\\.",
                                "^net\\.sf\\.cord$",
                                "^com\\.thinomenon\\.RemoteDesktopConnection$",
                                "^com\\.itap-mobile\\.qmote$",
                                "^com\\.nulana\\.remotixmac$",
                                "^com\\.p5sys\\.jump\\.mac\\.viewer$",
                                "^com\\.p5sys\\.jump\\.mac\\.viewer\\.",
                                "^com\\.teamviewer\\.TeamViewer$",
                                "^com\\.vmware\\.horizon$",
                                "^com\\.2X\\.Client\\.Mac$",
                                "^com\\.OpenText\\.Exceed-TurboX-Client$",
                                "^com\\.realvnc\\.vncviewer$",
                                "^com\\.citrix\\.receiver\\.icaviewer",
                                "^com\\.vmware\\.fusion$",
                                "^com\\.vmware\\.horizon$",
                                "^com\\.vmware\\.view$",
                                "^com\\.parallels\\.desktop$",
                                "^com\\.parallels\\.vm$",
                                "^com\\.parallels\\.desktop\\.console$",
                                "^org\\.virtualbox\\.app\\.VirtualBoxVM$",
                                "^com\\.citrix\\.XenAppViewer$",
                                "^com\\.vmware\\.proxyApp\\.",
                                "^com\\.parallels\\.winapp\\.",
                                "^com\\.utmapp\\.UTM$",
                                "^com\\.geekspiff\\.chickenofthevnc$",
                                "^net\\.sourceforge\\.chicken$",
                                "^de\\.jinx\\.JollysFastVNC\\.",
                                "^com\\.realvnc\\.vncviewer\\.",
                                "^com\\.microsoft\\.windowsapp$",
                                "^com\\.jumpdesktop\\.JumpDesktop$",
                                "^tv\\.parsec\\.www$"
                            ],
                            "type": "frontmost_application_unless"
                        }
                    ],
                    "from": {
                        "key_code": "spacebar",
                        "modifiers": {
                            "mandatory": [
                                "option"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "apple_vendor_keyboard_key_code": "spotlight",
                            "repeat": false
                        }
                    ]
                }
            ]
        },
        {
            "description": "Ctrl+click becomes Cmd+click in VS Code",
            "manipulators": [
                {
                    "type": "basic",
                    "conditions": [
                        {
                            "type": "frontmost_application_if",
                            "bundle_identifiers": [
                                "^com\\.microsoft\\.VSCode$"
                            ]
                        }
                    ],
                    "from": {
                        "pointing_button": "button1",
                        "modifiers": {
                            "mandatory": [
                                "control"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "pointing_button": "button1",
                            "modifiers": [
                                "left_command"
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "description": "Mouse side buttons navigate back/forward in VS Code",
            "manipulators": [
                {
                    "type": "basic",
                    "conditions": [
                        {
                            "type": "frontmost_application_if",
                            "bundle_identifiers": [
                                "^com\\.microsoft\\.VSCode$"
                            ]
                        }
                    ],
                    "from": {
                        "pointing_button": "button4",
                        "modifiers": {
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "hyphen",
                            "modifiers": [
                                "left_control"
                            ]
                        }
                    ]
                },
                {
                    "type": "basic",
                    "conditions": [
                        {
                            "type": "frontmost_application_if",
                            "bundle_identifiers": [
                                "^com\\.microsoft\\.VSCode$"
                            ]
                        }
                    ],
                    "from": {
                        "pointing_button": "button5",
                        "modifiers": {
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "hyphen",
                            "modifiers": [
                                "left_control",
                                "left_shift"
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
