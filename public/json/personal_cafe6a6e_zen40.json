  "rules": [
    {
      "description": "Hold Tab: shifted numbers (! @ # …) on the left ⌘ numpad positions",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "tab"
          },
          "to": [
            {
              "set_variable": {
                "name": "layer-tab",
                "value": 1
              }
            },
            {
              "set_variable": {
                "name": "__layer",
                "value": 1
              }
            }
          ],
          "conditions": [
            {
              "type": "variable_unless",
              "name": "layer-tab",
              "value": 1
            },
            {
              "type": "variable_unless",
              "name": "__layer",
              "value": 1
            }
          ],
          "to_if_alone": [
            {
              "key_code": "tab"
            }
          ],
          "to_after_key_up": [
            {
              "set_variable": {
                "name": "layer-tab",
                "value": 0
              }
            },
            {
              "set_variable": {
                "name": "__layer",
                "value": 0
              }
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "m"
          },
          "to": [
            {
              "key_code": "1",
              "modifiers": [
                "shift"
